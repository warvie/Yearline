{
  "expo": {
    "name": "Yearline",
    "slug": "yearline",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.vertexlazer.yearline",
      "buildNumber": "1",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "plugins": [
      "expo-notifications",
      [
        "expo-image-picker",
        {
          "photosPermission": "Yearline uses your photos to attach pictures and videos to the steps of an event."
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": false
        }
      ],
      "expo-video",
      "expo-document-picker"
    ],
    "extra": {
      "eas": {
        "projectId": "014b720d-9401-49a8-b5ad-fcd66bce7f4a"
      }
    },
    "owner": "vertexlazer",
    "web": {
      "bundler": "metro",
      "output": "single",
      "name": "Yearline",
      "shortName": "Yearline",
      "backgroundColor": "#111315",
      "themeColor": "#000000",
      "favicon": "./assets/favicon.png"
    },
    "experiments": {
      "baseUrl": "/Yearline"
    }
  }
}
